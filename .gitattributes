# Normalize line endings to LF in the repository.
# Editors on Windows were rewriting sources to CRLF, producing whole-file
# diffs with no semantic change.
* text=auto eol=lf

*.c    text eol=lf
*.cpp  text eol=lf
*.h    text eol=lf
*.hpp  text eol=lf
*.ino  text eol=lf
*.py   text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.ini  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# Binary assets — never touch.
*.png  binary
*.jpg  binary
*.bin  binary
*.wav  binary
*.mp3  binary
